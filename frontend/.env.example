# RentFlow API Base URL
# Development default: http://127.0.0.1:8000
# Production Vercel Deployment: Set VITE_API_BASE_URL to your deployed HTTPS Render backend URL (e.g. https://rentflow-kagw.onrender.com)
# NOTE: Never put JWT_SECRET_KEY, DATABASE_URL, or backend secrets in frontend environment variables.
VITE_API_BASE_URL=https://rentflow-kagw.onrender.com
