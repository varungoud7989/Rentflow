# Database configuration example for Neon/PostgreSQL production (Default: sqlite:///./rentflow.db)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE

# Authentication JWT Configuration (Replace with strong secrets in production)
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (Comma-separated list for production, e.g. https://rentflow.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
